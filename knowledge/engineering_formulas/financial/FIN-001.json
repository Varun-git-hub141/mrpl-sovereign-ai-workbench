  "formula_id": "FIN-001",
  "formula_name": "Percentage Deviation / Variance",
  "category": "financial",
  "description": "Calculates percentage change between baseline reference and observed value.",
  "mathematical_expression": "Pct_Change = ((observed_value - baseline_value) / baseline_value) * 100.0",
  "formula": "((observed_value - baseline_value) / baseline_value) * 100.0",
  "required_inputs": [
